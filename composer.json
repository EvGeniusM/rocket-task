{
    "name": "eugene/rocket-task",
    "description": "REST API Task: PHP 8.2, MySQL 8, MVC + Service Layer",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Eugene",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "bramus/router": "^1.6",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "php-cs-fixer": "php-cs-fixer fix src"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}